# Variables de entorno para el proyecto SalesMap / Bemap.pro
# Copia este archivo como .env y completa con tus valores reales de Supabase

# URL de tu proyecto Supabase
# Encuéntrala en: Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://TUPROYECTO.supabase.co

# Clave pública anon (segura para exponer en el frontend)
# Encuéntrala en: Supabase → Project Settings → API → anon (public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
